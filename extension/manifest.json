{
  "manifest_version": 3,
  "name": "RemoteBridge",
  "short_name": "RemoteBridge",
  "version": "0.1.0",
  "description": "See your RemoteBridge devices, get support, and open the host app.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "RemoteBridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://remotebridge.floot.app/*"
  ],
  "minimum_chrome_version": "116"
}
